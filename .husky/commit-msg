#!/bin/sh

COMMIT_MSG_FILE=$1
MSG=$(cat "$COMMIT_MSG_FILE")

if echo "$MSG" | grep -qE "^Merge"; then
  exit 0
fi

get_emoji() {
  case $1 in
    feat) echo "✨" ;;
    fix) echo "🐛" ;;
    docs) echo "📝" ;;
    style) echo "🎨" ;;
    refactor) echo "♻️" ;;
    test) echo "✅" ;;
    chore) echo "🔧" ;;
    build) echo "🏗" ;;
    ci) echo "👷" ;;
    revert) echo "⏪" ;;
    perf) echo "⚡️" ;;
    *) echo "" ;;
  esac
}

# Извлекаем тип из сообщения
TYPE=$(echo "$MSG" | sed -E 's/^([a-zA-Z]+)(\([^)]+\))?:.*/\1/')
EMOJI=$(get_emoji "$TYPE")

if [ -n "$EMOJI" ]; then
  if echo "$MSG" | grep -qE "^$TYPE\([^)]+\):"; then
    NEW_MSG=$(echo "$MSG" | sed -E "s/(^$TYPE\([^)]+\):)(.*)/\1 $EMOJI\2/")
  else
    NEW_MSG=$(echo "$MSG" | sed -E "s/(^$TYPE:)(.*)/\1 $EMOJI\2/")
  fi
  
  if ! echo "$NEW_MSG" | grep -qE " $EMOJI.* $EMOJI"; then
    echo "$NEW_MSG" > "$COMMIT_MSG_FILE"
  fi
fi

# Запускаем проверку
yarn commitlint --edit "$1"