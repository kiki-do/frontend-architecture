#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Путь к сообщению коммита
COMMIT_MSG_FILE=$1

# Считай сообщение
MSG=$(cat "$COMMIT_MSG_FILE")

# Если это merge-коммит — пропускаем
if echo "$MSG" | grep -qE "^Merge"; then
  exit 0
fi

# Маппинг типов на emoji
get_emoji() {
  case $1 in
    feat) echo "✨" ;;
    fix) echo "🐛" ;;
    docs) echo "📝" ;;
    style) echo "🎨" ;;
    refactor) echo "♻️" ;;
    test) echo "✅" ;;
    chore) echo "🔧" ;;
    build) echo "🏗" ;;
    ci) echo "👷" ;;
    revert) echo "⏪" ;;
    perf) echo "⚡️" ;;
    *) echo "" ;;
  esac
}

# Извлечь type из коммита
TYPE=$(echo "$MSG" | cut -d: -f1 | tr -d ' ')

EMOJI=$(get_emoji "$TYPE")

# Добавить emoji, если ещё нет
if [ -n "$EMOJI" ] && ! echo "$MSG" | grep -q "$EMOJI"; then
  echo "$EMOJI $MSG" > "$COMMIT_MSG_FILE"
fi
